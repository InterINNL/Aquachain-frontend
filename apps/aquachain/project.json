{
  "name": "aquachain",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "",
  "sourceRoot": "apps/aquachain/src",
  "tags": ["scope:aquachain"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/aquachain",
        "browser": "apps/aquachain/src/main.ts",
        "server": "apps/aquachain/src/main.server.ts",
        "outputMode": "static",
        "ssr": {
          "entry": "apps/aquachain/src/server.ts"
        },
        "polyfills": ["zone.js", "apps/aquachain/src/polyfills.ts"],
        "allowedCommonJsDependencies": ["bootstrap", "@cosmjs", "leaflet"],
        "tsConfig": "apps/aquachain/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "baseHref": "/aquachain/",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/aquachain/public"
          }
        ],
        "styles": [
          "node_modules/@fortawesome/fontawesome-svg-core/styles.css",
          "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
          "node_modules/bootstrap/dist/css/bootstrap.min.css",
          "node_modules/leaflet/dist/leaflet.css",
          "apps/aquachain/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "5mb",
              "maximumError": "6mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/aquachain/src/environments/environment.ts",
              "with": "apps/aquachain/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "baseHref": "/"
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "aquachain:build:production"
        },
        "development": {
          "buildTarget": "aquachain:build:development"
        }
      },
      "options": {
        "proxyConfig": "proxy.conf.json"
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "aquachain:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../coverage/apps/aquachain"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "aquachain:build",
        "port": 4200,
        "staticFilePath": "dist/apps/aquachain/browser",
        "spa": true
      }
    }
  }
}
