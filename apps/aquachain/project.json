{
  "name": "aquachain",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "",
  "sourceRoot": "apps/aquachain/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/aquachain",
        "browser": "apps/aquachain/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/aquachain/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/aquachain/public"
          }
        ],
        "styles": [
          "node_modules/@fortawesome/fontawesome-svg-core/styles.css",
          "node_modules/bootstrap/dist/css/bootstrap.min.css",
          "node_modules/ngx-toastr/toastr.css",
          "apps/aquachain/src/styles.scss"
        ],
        "server": "apps/aquachain/src/main.server.ts",
        "ssr": {
          "entry": "apps/aquachain/src/server.ts"
        },
        "outputMode": "server"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "3mb",
              "maximumError": "4mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "aquachain:build:production"
        },
        "development": {
          "buildTarget": "aquachain:build:development"
        }
      },
      "options": {
        "proxyConfig": "proxy.conf.json"
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "aquachain:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "reportsDirectory": "../../coverage/apps/aquachain"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "aquachain:build",
        "port": 4200,
        "staticFilePath": "dist/apps/aquachain/browser",
        "spa": true
      }
    }
  }
}